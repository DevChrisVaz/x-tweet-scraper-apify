# Vercel Marketplace injects KV_REST_API_* for the attached Upstash resource.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional canonical aliases. If both mappings exist, UPSTASH_REDIS_REST_* wins.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared only between the Apify Actor and the Vercel signer. Never commit values.
ENTITLEMENT_ENDPOINT=
ENTITLEMENT_HMAC_SECRET=
ENTITLEMENT_PUBLIC_KEY=
ENTITLEMENT_SIGNING_PRIVATE_KEY=
ENTITLEMENT_SIGNING_KEY_ID=primary
CANONICAL_ACTOR_ID=

# Explicit, opt-in HTTP-only live smoke targets. Not used by normal Actor runs.
LIVE_SMOKE_CONFIRM=
LIVE_X_USERNAME=
LIVE_X_TWEET_ID=
LIVE_X_PROXY_URL=

# Explicit benchmark target. Official paid benchmark evidence remains a Task 6 artifact.
BENCHMARK_CONFIRM=
BENCHMARK_USERNAME=
BENCHMARK_TWEET_ID=
BENCHMARK_MAX_RESULTS=100
BENCHMARK_PROXY_URL=
