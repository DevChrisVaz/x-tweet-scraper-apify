{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "X Tweet Scraper input",
  "schemaVersion": 1,
  "type": "object",
  "properties": {
    "fromUsers": {
      "title": "Target Users",
      "description": "Array of X usernames to scrape.",
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "editor": "stringList"
    },
    "tweetIds": {
      "title": "Tweet IDs",
      "description": "Array of specific Tweet IDs to scrape.",
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "editor": "stringList"
    },
    "searchTerms": {
      "title": "Search Terms",
      "description": "Unsupported.",
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "editor": "stringList"
    },
    "hashtags": {
      "title": "Hashtags",
      "description": "Array of hashtags to scrape.",
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "editor": "stringList"
    },
    "since": {
      "title": "Since Date",
      "description": "ISO-8601 date or timestamp, inclusive.",
      "type": "string",
      "editor": "textfield"
    },
    "until": {
      "title": "Until Date",
      "description": "ISO-8601 date or timestamp, inclusive.",
      "type": "string",
      "editor": "textfield"
    },
    "language": {
      "title": "Language",
      "description": "Language code of the tweets.",
      "type": "string",
      "editor": "textfield"
    },
    "minLikes": {
      "title": "Minimum Likes",
      "description": "Minimum number of likes.",
      "type": "integer",
      "editor": "number"
    },
    "minRetweets": {
      "title": "Minimum Retweets",
      "description": "Minimum number of retweets.",
      "type": "integer",
      "editor": "number"
    },
    "minReplies": {
      "title": "Minimum Replies",
      "description": "Minimum number of replies.",
      "type": "integer",
      "editor": "number"
    },
    "onlyVerified": {
      "title": "Only Verified",
      "description": "Only scrape tweets from verified users.",
      "type": "boolean",
      "default": false,
      "editor": "checkbox"
    },
    "mediaType": {
      "title": "Media Type",
      "description": "Filter tweets by media type.",
      "type": "string",
      "enum": ["any", "text_only", "images", "video", "links"],
      "default": "any",
      "editor": "select"
    },
    "includeReplies": {
      "title": "Include Replies",
      "description": "Include replies in the scraped tweets.",
      "type": "boolean",
      "default": true,
      "editor": "checkbox"
    },
    "includeRetweets": {
      "title": "Include Retweets",
      "description": "Include retweets in the scraped tweets.",
      "type": "boolean",
      "default": false,
      "editor": "checkbox"
    },
    "sortBy": {
      "title": "Sort By",
      "description": "Sort order of the tweets.",
      "type": "string",
      "enum": ["latest"],
      "default": "latest",
      "editor": "select"
    },
    "maxResults": {
      "title": "Maximum Results",
      "description": "Maximum number of results to return.",
      "type": "integer",
      "default": 100,
      "editor": "number"
    },
    "proxyConfiguration": {
      "title": "Proxy Configuration",
      "description": "Proxy configuration to use.",
      "type": "object",
      "editor": "proxy"
    },
    "authCookies": {
      "title": "Auth Cookies",
      "description": "Array of X authentication cookies (e.g. 'auth_token=...; ct0=...'). If provided, the scraper will use them instead of Guest Tokens.",
      "type": "array",
      "items": { "type": "string" },
      "default": [],
      "editor": "stringList"
    }
  }
}
