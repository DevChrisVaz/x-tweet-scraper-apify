{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "X Tweet Scraper input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fromUsers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "tweetIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "searchTerms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 0, "default": [], "description": "Unsupported; the platform boundary rejects non-empty values." },
    "hashtags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
    "since": { "type": "string", "description": "ISO-8601 date or timestamp, inclusive." },
    "until": { "type": "string", "description": "ISO-8601 date or timestamp, inclusive." },
    "language": { "type": "string", "pattern": "^[A-Za-z]{2}$" },
    "minLikes": { "type": "integer", "minimum": 0 },
    "minRetweets": { "type": "integer", "minimum": 0 },
    "minReplies": { "type": "integer", "minimum": 0 },
    "onlyVerified": { "type": "boolean", "default": false },
    "mediaType": { "type": "string", "enum": ["any", "text_only", "images", "video", "links"], "default": "any" },
    "includeReplies": { "type": "boolean", "default": true },
    "includeRetweets": { "type": "boolean", "default": false },
    "sortBy": { "type": "string", "enum": ["latest"], "default": "latest" },
    "maxResults": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 100 },
    "proxyConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useApifyProxy": { "type": "boolean", "default": false },
        "apifyProxyGroups": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "apifyProxyCountry": { "type": "string", "minLength": 1 }
      }
    }
  },
  "anyOf": [
    { "required": ["fromUsers"], "properties": { "fromUsers": { "minItems": 1 } } },
    { "required": ["tweetIds"], "properties": { "tweetIds": { "minItems": 1 } } }
  ]
}
